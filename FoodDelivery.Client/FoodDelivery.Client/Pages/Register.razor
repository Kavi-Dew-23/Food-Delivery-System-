@page "/register"
@using FoodDelivery.Client.Shared 
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager

<link href="css/pagestyles.css" rel="stylesheet" />

<div class="page-background">
    <div class="register-card">
        <h3>Register</h3>
        <div class="form-group-register">
            <label>Name</label>
            <input type="text" placeholder="Enter you Name" @bind="name" />
        </div>
        <div class="form-group-register">
            <label>Email</label>
            <input type="text" placeholder="Enter you Email"  @bind="email"/>
        </div>
        <div class="form-group-register">
            <label>Password</label>
            <input type="password" placeholder="Enter your password" @bind="password"/>
        </div>

        <button class="register-btn" @onclick="RegisterUser">
            Register
        </button>
        <p class="register-text">
            Already have an account? <a href="/login">Login</a>
        </p>

    </div>
</div>

@if(!string.IsNullOrEmpty(message))
{
    <div class="toast-top-right @toastClass">
        @message
    </div>
}

@code {
    string name;
    string email;
    string password;
    string message;
    string toastClass = string.Empty;


    private async Task RegisterUser()
    {
        var request = new
        {
            Name = name,
            Email = email,
            Password = password
        };

        var response = await Http.PostAsJsonAsync("http://localhost:5130/User/register", request);

        if(response.IsSuccessStatusCode)
        {
            message = "Registration Successful";
            toastClass = "toast-success";
            StateHasChanged();
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            message = "Registration Failed";
            toastClass = "toast-error";
            StateHasChanged();
            await Task.Delay(3000);
            message = "";
        }
    }
}