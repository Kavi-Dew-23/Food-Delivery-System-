@page "/login"
@using FoodDelivery.Client.Shared
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager

<link href="css/pagestyles.css" rel="stylesheet"/>

<div class="page-background">
    <div class="login-card">
        <h3>Welcome to MealMovers</h3>
        <div class="form-group">
            <label>Email Address</label>
            <input type="text"placeholder="Enter you Email" @bind="email"/>
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password"placeholder="Enter your password" @bind="password"/>
        </div>
        
        <button class="login-btn" @onclick="LoginUser">Login</button>

        <p class="register-text">
            New to MealMovers? <a href="/register">Register Here</a>
        </p>
        
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-top-right @toastClass">
        @message
    </div>
}


@code {
    string email = string.Empty;
    string password = string.Empty;
    string message = string.Empty;
    string toastClass = string.Empty;

    private async Task LoginUser()
    {
        var request = new
        {
            email = email,
            password = password
        };

        var response = await Http.PostAsJsonAsync("http://localhost:5130/User/login", request);

        if(response.IsSuccessStatusCode)
        {
            message = "Login Successfully";
            toastClass = "toast-success";
            StateHasChanged();

            await Task.Delay(2000);

            NavigationManager.NavigateTo("/");
        }
        else
        {
            message = "Login Failed";
            toastClass = "toast-error";
            StateHasChanged();
            await Task.Delay(2000);

            message = "";
        }
    }
}