@page "/login"
@using FoodDelivery.Client.Shared
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager

<link href="css/pagestyles.css" rel="stylesheet"/>

<div class="page-background">
    <div class="login-card">
        <h3>Welcome to MealMovers</h3>
        <div class="form-group">
            <label>Email Address</label>
            <input type="text"placeholder="Enter you Email" @bind="email"/>
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="text"placeholder="Enter your password" @bind="password"/>
        </div>
        
        <button class="login-btn" @onclick="LoginUser">Login</button>

        <p class="register-text">
            New to MealMovers? <a href="/register">Register Here</a>
        </p>
        
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="toast show-toast">
            @message
        </div>
    }
    @if (true)
    {
        <div class="toast show-toast" style="background:red;">
            DEBUG TOAST — should always be visible
        </div>
    }

</div>



@code {
    string email = string.Empty;
    string password = string.Empty;
    string message = string.Empty;

    private async Task LoginUser()
    {
        var request = new
        {
            email = email,
            password = password
        };

        var response = await Http.PostAsJsonAsync("http://localhost:5130/User/login", request);

        if(response.IsSuccessStatusCode)
        {
            message = "Login Successfully";
            StateHasChanged();

            await Task.Delay(1500);

            NavigationManager.NavigateTo("/");
        }
        else
        {
            message = "Login Failed";
            StateHasChanged();
        }
    }
}